
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "International Film Co-production Network",
    "subtitle": "Strongest country-pair relationships in TMDB-listed films, 1980–2025",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "offset": 15
  },
  "width": 850,
  "height": 450,
  "background": "#ffffff",
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#edf0f2",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/charts/country_coproductions.csv"
      },
      "transform": [
        {
          "filter": "isValid(datum.source_lon) && isValid(datum.source_lat) && isValid(datum.target_lon) && isValid(datum.target_lat)"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "movie_count",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank <= 40"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#c45b45",
        "opacity": 0.65
      },
      "encoding": {
        "longitude": {
          "field": "source_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "source_lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "target_lon"
        },
        "latitude2": {
          "field": "target_lat"
        },
        "size": {
          "field": "movie_count",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "range": [0.5, 5]
          },
          "legend": {
            "title": "Shared films"
          }
        },
        "tooltip": [
          {
            "field": "source_iso3",
            "type": "nominal",
            "title": "Country 1"
          },
          {
            "field": "target_iso3",
            "type": "nominal",
            "title": "Country 2"
          },
          {
            "field": "movie_count",
            "type": "quantitative",
            "title": "Shared films",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
