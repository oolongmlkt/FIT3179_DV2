{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "data/charts/movie_financials.csv",
        "format": {
            "type": "csv",
            "parse": {
                "budget_m": "number",
                "revenue_m": "number",
                "budget": "number",
                "revenue": "number",
                "roi": "number",
                "year": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "isValid(datum.budget_m) && isValid(datum.revenue_m) && datum.budget_m > 0 && datum.revenue_m > 0"
        }
    ],
    "params": [
        {
            "name": "genreSelection",
            "select": {
                "type": "point",
                "fields": [
                    "genre"
                ]
            },
            "bind": "legend"
        }
    ],
    "width": 500,
    "height": 450,
    "mark": {
        "type": "circle",
        "size": 30
    },
    "encoding": {
        "x": {
            "field": "budget_m",
            "type": "quantitative",
            "scale": {
                "type": "log"
            },
            "axis": {
                "title": "Production Budget (USD millions)",
                "grid": true
            }
        },
        "y": {
            "field": "revenue_m",
            "type": "quantitative",
            "scale": {
                "type": "log"
            },
            "axis": {
                "title": "Worldwide Revenue (USD millions)",
                "grid": true
            }
        },
        "color": {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
        },
        "opacity": {
            "condition": {
                "param": "genreSelection",
                "value": 0.75
            },
            "value": 0.04
        },
        "tooltip": [
            {
                "field": "title",
                "type": "nominal",
                "title": "Movie"
            },
            {
                "field": "year",
                "type": "quantitative",
                "format": "d",
                "title": "Release Year"
            },
            {
                "field": "genre",
                "type": "nominal",
                "title": "Genre"
            },
            {
                "field": "budget",
                "type": "quantitative",
                "format": "$,.0f",
                "title": "Budget"
            },
            {
                "field": "revenue",
                "type": "quantitative",
                "format": "$,.0f",
                "title": "Revenue"
            },
            {
                "field": "roi",
                "type": "quantitative",
                "format": ",.1f",
                "title": "Budget-based ROI (%)"
            }
        ]
    },
    "config": {
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12
        }
    }
}