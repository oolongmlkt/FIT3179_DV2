{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "Does a Bigger Budget Mean Bigger Box Office Returns?",
        "subtitle": "Production budget versus worldwide revenue, 1980–2025",
        "anchor": "start",
        "fontSize": 17,
        "subtitleFontSize": 12,
        "offset": 18
    },
    "data": {
        "url": "/data/charts/movie_financials.csv",
        "format": {
            "type": "csv",
            "parse": {
                "budget_m": "number",
                "revenue_m": "number",
                "budget": "number",
                "revenue": "number",
                "roi": "number",
                "year": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "isValid(datum.budget_m) && isValid(datum.revenue_m) && datum.budget_m > 0 && datum.revenue_m > 0"
        }
    ],
    "width": 700,
    "height": 450,
    "mark": {
        "type": "circle",
        "size": 55,
        "opacity": 0.45,
        "stroke": "white",
        "strokeWidth": 0.3
    },
    "encoding": {
        "x": {
            "field": "budget_m",
            "type": "quantitative",
            "scale": {
                "type": "log"
            },
            "axis": {
                "title": "Production Budget (USD millions)",
                "grid": true
            }
        },
        "y": {
            "field": "revenue_m",
            "type": "quantitative",
            "scale": {
                "type": "log"
            },
            "axis": {
                "title": "Worldwide Revenue (USD millions)",
                "grid": true
            }
        },
        "color": {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
        },
        "tooltip": [
            {
                "field": "title",
                "type": "nominal",
                "title": "Movie"
            },
            {
                "field": "year",
                "type": "quantitative",
                "format": "d",
                "title": "Release Year"
            },
            {
                "field": "genre",
                "type": "nominal",
                "title": "Genre"
            },
            {
                "field": "budget",
                "type": "quantitative",
                "format": "$,.0f",
                "title": "Budget"
            },
            {
                "field": "revenue",
                "type": "quantitative",
                "format": "$,.0f",
                "title": "Revenue"
            },
            {
                "field": "roi",
                "type": "quantitative",
                "format": ",.1f",
                "title": "Budget-based ROI (%)"
            }
        ]
    },
    "config": {
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12
        }
    }
}