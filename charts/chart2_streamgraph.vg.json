{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": 380,
    "data": {
        "url": "data/charts/genre_by_year.csv"
    },
    "params": [
        {
            "name": "genre_selection",
            "select": {
                "type": "point",
                "fields": [
                    "genre"
                ],
                "on": "click",
                "clear": "dblclick",
                "toggle": true
            },
            "bind": "legend"
        }
    ],
    "mark": {
        "type": "area",
        "interpolate": "monotone",
        "stroke": "white",
        "strokeWidth": 0.4
    },
    "encoding": {
        "x": {
            "field": "year",
            "type": "quantitative",
            "title": "Release Year",
            "scale": {
                "domain": [
                    1980,
                    2025
                ],
                "nice": false
            },
            "axis": {
                "format": "d",
                "tickCount": 10,
                "grid": false
            }
        },
        "y": {
            "field": "movie_count",
            "type": "quantitative",
            "stack": "center",
            "axis": null
        },
        "color": {
            "field": "genre",
            "type": "nominal",
            "title": "Movie Genre",
            "scale": {
                "scheme": "tableau20"
            },
            "legend": {
                "orient": "right",
                "symbolType": "square",
                "symbolSize": 130
            }
        },
        "opacity": {
            "condition": {
                "param": "genre_selection",
                "value": 0.95
            },
            "value": 0.15
        },
        "order": {
            "field": "genre",
            "type": "nominal",
            "sort": "ascending"
        },
        "tooltip": [
            {
                "field": "genre",
                "title": "Movie Genre"
            },
            {
                "field": "year",
                "title": "Release Year"
            },
            {
                "field": "movie_count",
                "title": "Genre Credits",
                "format": ","
            }
        ]
    }
}