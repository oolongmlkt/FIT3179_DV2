{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "projection": {
    "type": "equalEarth"
  },
  "data": {
    "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
    "format": {
      "type": "topojson",
      "feature": "countries"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.id)",
      "as": "map_country_id"
    },
    {
      "lookup": "map_country_id",
      "from": {
        "data": {
          "url": "data/charts/country_production.csv",
          "format": {
            "type": "csv",
            "parse": {
              "average_annual_movies_per_million": "number",
              "valid_population_years": "number",
              "movies_in_valid_years": "number"
            }
          }
        },
        "key": "iso_numeric",
        "fields": [
          "standard_name",
          "average_annual_movies_per_million",
          "valid_population_years",
          "movies_in_valid_years"
        ]
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#e6e8eb",
        "stroke": "white",
        "strokeWidth": 0.45
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.average_annual_movies_per_million)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.45
      },
      "encoding": {
        "color": {
          "field": "average_annual_movies_per_million",
          "type": "quantitative",
          "title": "Movies per million / year",
          "scale": {
            "type": "symlog",
            "constant": 1,
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 360,
            "gradientThickness": 14,
            "values": [
              0,
              1,
              5,
              20,
              60
            ],
            "format": ".0f",
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titlePadding": 10,
            "labelOffset": 5
          }
        },
        "tooltip": [
          {
            "field": "standard_name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "average_annual_movies_per_million",
            "type": "quantitative",
            "title": "Movies per million / year",
            "format": ".2f"
          },
          {
            "field": "movies_in_valid_years",
            "type": "quantitative",
            "title": "Movie credits (valid years)",
            "format": ",d"
          },
          {
            "field": "valid_population_years",
            "type": "quantitative",
            "title": "Years with population data"
          }
        ]
      }
    }
  ]
}